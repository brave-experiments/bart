{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "src/**/*.js"]
}
