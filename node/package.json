{
  "name": "bart",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-package-names --validate-integrity"
  },
  "dependencies": {
    "clawperator": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "lockfile-lint": "5.0.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
